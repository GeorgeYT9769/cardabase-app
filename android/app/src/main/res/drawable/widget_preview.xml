<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Blue outer border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2196F3" />
        </shape>
    </item>

    <!-- White card -->
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- Barcode simulated with dashed line to prevent VectorDrawable crash in widget picker -->
    <item
        android:width="120dp"
        android:gravity="center">
        <shape android:shape="line">
            <stroke
                android:width="60dp"
                android:color="#000000"
                android:dashWidth="12dp"
                android:dashGap="8dp" />
        </shape>
    </item>

</layer-list>